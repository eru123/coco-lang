// ============================================================================
// Main Function
// ============================================================================

fn main(): int {
    print("=== Pipe Operator Examples ===\n");

    print("Example 0: Basic $$ usage");
    example0();

    print("\nExample 1: Array transformations");
    example1();

    print("\nExample 2: Alternative -> syntax");
    example2();

    print("\nExample 3: Right-to-left with <|");
    example3();

    print("\nExample 4: Right-to-left with <-");
    example4();

    print("\nExample 7: Comparison of styles");
    example7();

    print("\nExample 10: Mixed $$ and lambda");
    example10();

    print("\nFor complex examples (5, 6, 8, 9), see the function definitions above.");

    return 0;
}

// Stub functions for compilation (would be real in actual code)
fn parseJson(s: string): Result<mixed, Error> { return Ok({}); }
fn validate(data: mixed): Result<mixed, Error> { return Ok(data); }
fn format(data: mixed): string { return "formatted"; }
async fn fetchUsers(): list<User> { return []; }
async fn enrichWithProfiles(users: list<User>): list<User> { return users; }
async fn filterByPermissions(users: list<User>): list<User> { return users; }
async fn fetch(url: string): Result<Response, Error> { return Err(new Error("stub")); }
class Response {
    async fn json(): Result<mixed, Error> { return Ok({}); }
}
