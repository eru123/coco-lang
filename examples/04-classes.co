// Classes in Coco
// - Use 'this' or '$' to access instance members (both equivalent)
// - Visibility: public, protected, private, readonly, static
// - Properties default to private, methods default to public
// - Methods can use: direct name, function, fn, or f (NO arrow functions)

class Animal {
    constructor(
        public readonly species: string,
        public name: string,
        private sound: string,
    ) {}

    // Method without keyword (direct name):
    speak(): string {
        return `${$.name} says ${$.sound}`;
    }

    // Method with function keyword:
    function describe(): string {
        return `A ${$.species} named ${$.name}`;
    }

    // Method with fn keyword:
    fn rename(name: string): void {
        this.name = name;
    }

    // Method with f keyword:
    f makeSound(): void {
        print($.sound);
    }

    // Static methods (can also use function, fn, f):
    static dog(name: string): Animal {
        return new Animal(species: "Dog", name: name, sound: "woof");
    }

    static function cat(name: string): Animal {
        return new Animal(species: "Cat", name: name, sound: "meow");
    }
}

class Pet extends Animal {
    constructor(
        species: string,
        name: string,
        sound: string,
        public owner: string,
    ) {
        super(species, name, sound);
    }

    introduce(): string {
        return `${this.name} belongs to ${$.owner}`;  // mix this and $ freely
    }
}

interface Feedable {
    feed(food: string): void;
    isHungry(): bool;
}

class HomePet extends Pet implements Feedable {
    private hunger: int = 50;

    feed(food: string): void {
        $.hunger -= 20;
        print(`${$.name} eats ${food}`);
    }

    isHungry(): bool {
        return $.hunger > 70;
    }
}

fn main(): int {
    const dog = Animal.dog("Rex");
    print(dog.speak());      // direct method
    print(dog.describe());   // function keyword method
    dog.rename("Max");       // fn keyword method
    dog.makeSound();         // f keyword method

    const cat = Animal.cat("Whiskers");
    print(cat.speak());

    const pet = new Pet(
        species: "Bird",
        name: "Tweety",
        sound: "chirp",
        owner: "Jericho",
    );
    print(pet.introduce());
    print(pet.speak());

    return 0;
}
