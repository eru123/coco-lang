// Functions in Coco
// Named functions: function, fn, or f keywords
// Anonymous functions: function, fn, f, or arrow () => {}

// === NAMED FUNCTIONS ===

// Full keyword:
function add(a: int, b: int): int {
    return a + b;
}

// Short keyword:
fn subtract(a: int, b: int): int {
    return a - b;
}

// Shortest keyword:
f multiply(a: int, b: int): int {
    return a * b;
}

// === ANONYMOUS FUNCTIONS ===

// Anonymous with function keyword:
const divide = function(a: int, b: int): int {
    return a / b;
};

// Anonymous with fn keyword:
const modulo = fn(a: int, b: int): int {
    return a % b;
};

// Anonymous with f keyword:
const power = f(a: int, b: int): int {
    return a ** b;
};

// Arrow function (expression body):
const square = (n: int): int => n * n;

// Arrow function (block body):
const clamp = (value: int, min: int, max: int): int => {
    if value < min { return min; }
    if value > max { return max; }
    return value;
};

// Named arguments:
fn createUser(name: string, age: int, email: string): string {
    return `${name} (${age}) <${email}>`;
}

// Default parameters:
fn greet(name: string, greeting: string = "Hello"): string {
    return `${greeting}, ${name}!`;
}

// Returning Result:
f safeDivide(a: int, b: int): Result<int, string> {
    if b == 0 {
        return Err("division by zero");
    }
    return Ok(a / b);
}

// Async variants:
async function fetchUser(id: int): Result<User, Error> {
    return await http.get(`/users/${id}`);
}

async fn getPost(id: int): Result<Post, Error> {
    return await http.get(`/posts/${id}`);
}

async f loadComment(id: int): Result<Comment, Error> {
    return await http.get(`/comments/${id}`);
}

fn main(): int {
    // Named functions:
    print(add(2, 3));        // function keyword
    print(subtract(5, 2));   // fn keyword
    print(multiply(4, 5));   // f keyword

    // Anonymous functions:
    print(divide(10, 2));    // anonymous with function
    print(modulo(10, 3));    // anonymous with fn
    print(power(2, 3));      // anonymous with f
    print(square(6));        // arrow function
    print(clamp(15, 0, 10)); // arrow function (block)

    // Named arguments at call site:
    print(createUser(name: "Jericho", age: 28, email: "j@ex.com"));

    // Default parameter:
    print(greet("World"));
    print(greet("Coco", greeting: "Hey"));

    // Result handling:
    const result = safeDivide(10, 3);
    match result {
        is Ok(v) => print(`Result: ${v}`),
        is Err(e) => print(`Error: ${e}`),
    };

    // Callbacks with different styles:
    const numbers = [1, 2, 3, 4, 5];

    const doubled = numbers.map((n) => n * 2);
    const filtered = numbers.filter(fn(n) { return n > 2; });
    const processed = numbers.map(function(n) { return n * n; });

    return 0;
}
