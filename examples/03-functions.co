// Functions in Coco
// Coco supports multiple function declaration styles:
// - function (full keyword)
// - fn (short keyword)
// - f (shortest keyword)
// - () => {} (arrow functions)

// Full keyword:
function add(a: int, b: int): int {
    return a + b;
}

// Short keyword:
fn subtract(a: int, b: int): int {
    return a - b;
}

// Shortest keyword:
f multiply(a: int, b: int): int {
    return a * b;
}

// Untyped function (gradual):
fn divide(a, b) {
    return a / b;
}

// Arrow function:
const square = (n: int): int => n * n;

// Multi-line arrow:
const clamp = (value: int, min: int, max: int): int => {
    if value < min { return min; }
    if value > max { return max; }
    return value;
};

// Named arguments:
fn createUser(name: string, age: int, email: string): string {
    return `${name} (${age}) <${email}>`;
}

// Default parameters:
fn greet(name: string, greeting: string = "Hello"): string {
    return `${greeting}, ${name}!`;
}

// Returning Result:
f safeDivide(a: int, b: int): Result<int, string> {
    if b == 0 {
        return Err("division by zero");
    }
    return Ok(a / b);
}

// Async variants:
async function fetchUser(id: int): Result<User, Error> {
    return await http.get(`/users/${id}`);
}

async fn getPost(id: int): Result<Post, Error> {
    return await http.get(`/posts/${id}`);
}

async f loadComment(id: int): Result<Comment, Error> {
    return await http.get(`/comments/${id}`);
}

fn main(): int {
    // All function keywords work the same:
    print(add(2, 3));        // function keyword
    print(subtract(5, 2));   // fn keyword
    print(multiply(4, 5));   // f keyword
    print(divide(10, 2));    // untyped fn
    print(square(6));        // arrow function
    print(clamp(15, 0, 10));

    // Named arguments at call site:
    print(createUser(name: "Jericho", age: 28, email: "j@ex.com"));

    // Default parameter:
    print(greet("World"));
    print(greet("Coco", greeting: "Hey"));

    // Result handling:
    const result = safeDivide(10, 3);
    match result {
        is Ok(v) => print(`Result: ${v}`),
        is Err(e) => print(`Error: ${e}`),
    };

    return 0;
}
