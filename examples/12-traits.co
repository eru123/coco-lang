// Traits in Coco

trait Timestamps {
    createdAt: DateTime|null = null;
    updatedAt: DateTime|null = null;

    touch(): void {
        $.updatedAt = DateTime.now();  // $ works in traits
    }

    wasModified(): bool {
        return $.updatedAt != null;
    }
}

trait SoftDelete {
    deletedAt: DateTime|null = null;

    softDelete(): void {
        $.deletedAt = DateTime.now();
    }

    restore(): void {
        $.deletedAt = null;
    }

    isDeleted(): bool {
        return this.deletedAt != null;  // can use this or $
    }
}

trait Sluggable {
    slug: string = "";

    generateSlug(source: string): void {
        $.slug = source.toLowerCase().replace(" ", "-").replace("[^a-z0-9-]", "");
    }
}

class Article {
    use Timestamps, SoftDelete, Sluggable;

    constructor(
        public readonly id: int,
        public title: string,
        public body: string,
    ) {
        $.generateSlug(title);
        $.createdAt = DateTime.now();
    }

    update(title: string, body: string): void {
        $.title = title;
        $.body = body;
        $.generateSlug(title);
        $.touch();
    }
}

fn main(): int {
    const article = new Article(
        id: 1,
        title: "Hello Coco World",
        body: "This is an article about Coco.",
    );

    print(`Slug: ${article.slug}`);
    print(`Modified: ${article.wasModified()}`);

    article.update("Updated Title", "New body");
    print(`Modified: ${article.wasModified()}`);
    print(`New slug: ${article.slug}`);

    article.softDelete();
    print(`Deleted: ${article.isDeleted()}`);

    article.restore();
    print(`Deleted: ${article.isDeleted()}`);

    return 0;
}
