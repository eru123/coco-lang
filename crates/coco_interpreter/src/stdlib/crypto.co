// std/crypto — Cryptographic hash with streaming support.

class Hash {
    private data: string;

    constructor() {
        $.data = "";
    }

    public update(input: string): Hash {
        $.data = $.data + input;
        return $;
    }

    public digest(): string {
        return sha256($.data);
    }

    public hex(): string {
        // SHA256 already returns hex
        return sha256($.data);
    }

    static sha256(input: string): string {
        return sha256(input);
    }
}

export fn sha256(input: string): string {
    return sha256(input);
}
