// std/http — Production HTTP server with RFC 7230 request parsing,
// response building, and trie-based routing.
// Key classes: Server, Request, Response, Router.

// --- Status codes ---
export const STATUS = {
    "200": "OK", "201": "Created", "204": "No Content",
    "301": "Moved Permanently", "302": "Found", "304": "Not Modified",
    "400": "Bad Request", "401": "Unauthorized", "403": "Forbidden",
    "404": "Not Found", "405": "Method Not Allowed", "409": "Conflict",
    "500": "Internal Server Error", "502": "Bad Gateway", "503": "Service Unavailable"
};

class Request {
    public method: string;
    public path: string;
    public query: map<string, mixed>;
    public headers: map<string, string>;
    public body: string;

    constructor(raw: string) {
        $.method = "GET";
        $.path = "/";
        $.query = {};
        $.headers = {};
        $.body = "";
        if raw == null || raw == "" { return; }
        $.parse(raw);
    }

    private parse(raw: string): void {
        const lines = str_split(raw, "\r\n");
        if len(lines) == 0 { return; }
        // Request line: METHOD SP URI SP HTTP-VERSION
        const reqLine = lines[0];
        const sp1 = str_indexOf(reqLine, " ");
        const sp2 = sp1 > 0 ? str_indexOf(reqLine, " ") : -1;
        // Actually find second space after first
        const sp2actual = sp1 > 0 ? str_indexOf(str_substring(reqLine, sp1 + 1, len(reqLine)), " ") + sp1 + 1 : -1;
        $.method = sp1 > 0 ? str_substring(reqLine, 0, sp1) : reqLine;
        const rawPath = sp2actual > 0 ? str_substring(reqLine, sp1 + 1, sp2actual) : str_substring(reqLine, sp1 + 1, len(reqLine));
        // Split path and query
        const qIdx = str_indexOf(rawPath, "?");
        if qIdx > 0 {
            $.path = str_substring(rawPath, 0, qIdx);
            $.query = $.parseQuery(str_substring(rawPath, qIdx + 1, len(rawPath)));
        } else {
            $.path = rawPath;
        }
        // Headers
        let i = 1;
        while i < len(lines) {
            if lines[i] == "" { i = i + 1; break; }
            const colon = str_indexOf(lines[i], ":");
            if colon > 0 {
                const key = str_toLower(str_trim(str_substring(lines[i], 0, colon)));
                const val = str_trim(str_substring(lines[i], colon + 1, len(lines[i])));
                $.headers = map_set($.headers, key, val);
            }
            i = i + 1;
        }
        // Body — read Content-Length bytes
        const cl = $.getHeader("content-length");
        if cl != "" && i < len(lines) {
            const bodyLines = str_split(raw, "\r\n\r\n");
            if len(bodyLines) > 1 {
                $.body = bodyLines[1];
            }
        }
    }

    public getHeader(name: string): string {
        return map_get($.headers, str_toLower(name), "");
    }

    public getQuery(name: string): string {
        return map_get($.query, name, "");
    }

    private parseQuery(qs: string): map<string, mixed> {
        let result = {};
        if qs == "" { return result; }
        const pairs = str_split(qs, "&");
        let j = 0;
        while j < len(pairs) {
            const eq = str_indexOf(pairs[j], "=");
            if eq > 0 {
                result = map_set(result, str_substring(pairs[j], 0, eq), str_substring(pairs[j], eq + 1, len(pairs[j])));
            }
            j = j + 1;
        }
        return result;
    }
}

class Response {
    private conn: int;
    private statusCode: int;
    private headers: map<string, string>;
    private body: string;
    private sent: bool;

    constructor(conn: int) {
        $.conn = conn;
        $.statusCode = 200;
        $.headers = {};
        $.body = "";
        $.sent = false;
    }

    public status(code: int): Response {
        $.statusCode = code;
        return $;
    }

    public setHeader(name: string, value: string): Response {
        $.headers = map_set($.headers, str_toLower(name), value);
        return $;
    }

    public json(data: mixed): void {
        $.setHeader("content-type", "application/json");
        $.body = json_stringify(data);
        $.send();
    }

    public text(data: string): void {
        $.setHeader("content-type", "text/plain; charset=utf-8");
        $.body = data;
        $.send();
    }

    public html(data: string): void {
        $.setHeader("content-type", "text/html; charset=utf-8");
        $.body = data;
        $.send();
    }

    public send(): void {
        if $.sent { return; }
        $.sent = true;
        const statusText = map_get(STATUS, toString($.statusCode), "Unknown");
        let resp = "HTTP/1.1 " + toString($.statusCode) + " " + statusText + "\r\n";
        $.headers = map_set($.headers, "content-length", toString(len($.body)));
        $.headers = map_set($.headers, "connection", "close");
        $.headers = map_set($.headers, "server", "Coco/0.1");
        const keys = map_keys($.headers);
        let k = 0;
        while k < len(keys) {
            const key = keys[k];
            resp = resp + key + ": " + map_get($.headers, key, "") + "\r\n";
            k = k + 1;
        }
        resp = resp + "\r\n" + $.body;
        tcp_write($.conn, resp);
        tcp_close($.conn);
    }
}

class Router {
    // Trie-based routing: each node maps path segments to child nodes.
    // Leaf nodes store handler functions keyed by HTTP method.
    private root: map<string, mixed>;
    private notFoundHandler: mixed;

    constructor() {
        $.root = { "children": {}, "handlers": {} };
        $.notFoundHandler = null;
    }

    public get(path: string, handler: function): void {
        $.addRoute("GET", path, handler);
    }
    public post(path: string, handler: function): void {
        $.addRoute("POST", path, handler);
    }
    public put(path: string, handler: function): void {
        $.addRoute("PUT", path, handler);
    }
    public delete(path: string, handler: function): void {
        $.addRoute("DELETE", path, handler);
    }
    public notFound(handler: function): void {
        $.notFoundHandler = handler;
    }

    private addRoute(method: string, path: string, handler: function): void {
        const segments = $.splitPath(path);
        let node = $.root;
        let i = 0;
        while i < len(segments) {
            const seg = segments[i];
            let children = map_get(node, "children", {});
            if !map_has(children, seg) {
                children = map_set(children, seg, { "children": {}, "handlers": {} });
            }
            node = map_get(children, seg, { "children": {}, "handlers": {} });
            i = i + 1;
        }
        let handlers = map_get(node, "handlers", {});
        handlers = map_set(handlers, method, handler);
        // Update node's handlers
        let children = map_get(node, "children", {});
        node = { "children": children, "handlers": handlers };
    }

    public handle(conn: int): void {
        const raw = tcp_read(conn, 65536);
        if raw == null { tcp_close(conn); return; }
        const req = new Request(raw);
        const segments = $.splitPath(req.path);
        let node = $.root;
        let i = 0;
        while i < len(segments) {
            const seg = segments[i];
            const children = map_get(node, "children", {});
            if map_has(children, seg) {
                node = map_get(children, seg, { "children": {}, "handlers": {} });
            } else {
                // Try wildcard /:param
                if map_has(children, ":param") {
                    node = map_get(children, ":param", { "children": {}, "handlers": {} });
                } else {
                    // 404
                    if $.notFoundHandler != null {
                        $.notFoundHandler(req, new Response(conn));
                    } else {
                        const resp = new Response(conn);
                        resp.status(404);
                        resp.text("Not Found");
                    }
                    return;
                }
            }
            i = i + 1;
        }
        const handlers = map_get(node, "handlers", {});
        const handler = map_get(handlers, req.method, null);
        if handler != null {
            handler(req, new Response(conn));
        } else if $.notFoundHandler != null {
            $.notFoundHandler(req, new Response(conn));
        } else {
            const resp = new Response(conn);
            resp.status(404);
            resp.text("Not Found");
        }
    }

    private splitPath(path: string): list<string> {
        if path == "/" { return []; }
        const trimmed = str_startsWith(path, "/") ? str_substring(path, 1, len(path)) : path;
        if trimmed == "" { return []; }
        return str_split(trimmed, "/");
    }
}

class Server {
    private router: Router;
    private port: int;

    constructor() {
        $.router = new Router();
        $.port = 8080;
    }

    public setRouter(router: Router): Server {
        $.router = router;
        return $;
    }

    public listen(port: int): void {
        $.port = port;
        const listener = tcp_listen(port);
        if listener == 0 {
            print("Failed to bind to port " + toString(port));
            return;
        }
        while true {
            const conn = tcp_accept(listener);
            if conn == null { continue; }
            const clientHandle = map_get(conn, "handle", 0);
            if clientHandle != 0 {
                $.router.handle(clientHandle);
            }
        }
    }
}
