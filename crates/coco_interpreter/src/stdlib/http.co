// std/http — Production HTTP server with headers, JSON, routing, and query params.
// Depends on: tcp_* builtins, str_* builtins, json_parse/json_stringify, map_* builtins.

// ---- Core HTTP server ----
export fn createServer(port: int): int {
    return tcp_listen(port);
}

export fn accept(server: int): map<string, mixed> {
    return tcp_accept(server);
}

// ---- Request parsing ----
export fn readRequest(conn: int): map<string, mixed> {
    const raw = tcp_read(conn, 65536);
    if raw == null { return { "method": "GET", "path": "/" }; }
    return parseHttp(raw);
}

export fn parseHttp(raw: string): map<string, mixed> {
    const lines = str_split(raw, "\r\n");
    if len(lines) == 0 { return { "method": "GET", "path": "/" }; }
    const requestLine = lines[0];
    const parts = str_split(requestLine, " ");
    const method = parts[0];
    const pathAndQuery = parts[1];
    let path = pathAndQuery;
    let query = {};
    const qIdx = str_indexOf(pathAndQuery, "?");
    if qIdx != -1 {
        path = str_substring(pathAndQuery, 0, qIdx);
        const qs = str_substring(pathAndQuery, qIdx + 1, len(pathAndQuery));
        query = parseQueryString(qs);
    }
    // Parse headers
    let headers = {};
    let i = 1;
    while i < len(lines) {
        if lines[i] == "" { break; }
        const colon = str_indexOf(lines[i], ":");
        if colon > 0 {
            const key = str_trim(str_substring(lines[i], 0, colon));
            const val = str_trim(str_substring(lines[i], colon + 1, len(lines[i])));
            headers = map_set(headers, str_toLower(key), val);
        }
        i = i + 1;
    }
    // Body is everything after the blank line
    let body = "";
    if i + 1 < len(lines) {
        body = str_trim(lines[i + 1]);
    }
    return {
        "method": method,
        "path": path,
        "query": query,
        "headers": headers,
        "body": body,
    };
}

export fn parseQueryString(qs: string): map<string, mixed> {
    let result = {};
    if qs == "" { return result; }
    const pairs = str_split(qs, "&");
    let j = 0;
    while j < len(pairs) {
        const pair = pairs[j];
        const eqIdx = str_indexOf(pair, "=");
        if eqIdx > 0 {
            const key = str_substring(pair, 0, eqIdx);
            const val = str_substring(pair, eqIdx + 1, len(pair));
            result = map_set(result, key, val);
        }
        j = j + 1;
    }
    return result;
}

// ---- Response building ----
export const STATUS_CODES = {
    "200": "OK",
    "201": "Created",
    "204": "No Content",
    "301": "Moved Permanently",
    "302": "Found",
    "400": "Bad Request",
    "401": "Unauthorized",
    "403": "Forbidden",
    "404": "Not Found",
    "405": "Method Not Allowed",
    "500": "Internal Server Error",
    "502": "Bad Gateway",
    "503": "Service Unavailable",
};

export fn getStatusText(status: int): string {
    const key = toString(status);
    const text = map_get(STATUS_CODES, key, "Unknown");
    return text;
}

export fn jsonResponse(conn: int, status: int, data: mixed): void {
    const body = json_stringify(data);
    writeResponse(conn, status, body, "application/json");
}

export fn textResponse(conn: int, status: int, body: string): void {
    writeResponse(conn, status, body, "text/plain");
}

export fn htmlResponse(conn: int, status: int, body: string): void {
    writeResponse(conn, status, body, "text/html");
}

export fn writeResponse(conn: int, status: int, body: string, contentType: string): void {
    const statusText = getStatusText(status);
    let response = "HTTP/1.1 " + toString(status) + " " + statusText + "\r\n";
    response = response + "Content-Type: " + contentType + "\r\n";
    response = response + "Content-Length: " + toString(len(body)) + "\r\n";
    response = response + "Connection: close\r\n";
    response = response + "Server: Coco/0.1\r\n";
    response = response + "\r\n";
    response = response + body;
    tcp_write(conn, response);
    tcp_close(conn);
}

// ---- Simple router ----
export fn createRouter(): map<string, mixed> {
    return { "routes": {} };
}

export fn addRoute(router: map<string, mixed>, method: string, path: string, handler: mixed): map<string, mixed> {
    const routes = map_get(router, "routes", {});
    const key = method + " " + path;
    return map_set(router, "routes", map_set(routes, key, handler));
}

export fn route(router: map<string, mixed>, req: map<string, mixed>): mixed {
    const routes = map_get(router, "routes", {});
    const method = map_get(req, "method", "GET");
    const path = map_get(req, "path", "/");
    const key = method + " " + path;
    return map_get(routes, key, null);
}

// ---- Full server loop ----
export fn serve(port: int, handler: function): void {
    const server = createServer(port);
    if server == 0 {
        print("Failed to listen on port " + toString(port));
        return;
    }
    while true {
        const conn = accept(server);
        if conn == null { continue; }
        handler(conn);
    }
}
