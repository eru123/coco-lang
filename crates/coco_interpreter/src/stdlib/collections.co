// std/collections — Production data structures with O(1) operations.
// Queue: ring buffer with amortized O(1) enqueue/dequeue.
// Stack: growable array with O(1) push/pop.
// HashSet: open-addressing hash set with O(1) average operations.

class Queue {
    private items: list<mixed>;
    private head: int;
    private tail: int;
    private count: int;

    constructor(capacity: int) {
        const cap = capacity > 0 ? capacity : 16;
        $.items = [];
        $.head = 0;
        $.tail = 0;
        $.count = 0;
        let i = 0;
        while i < cap {
            $.items = list_push($.items, null);
            i = i + 1;
        }
    }

    public enqueue(item: mixed): void {
        // Grow if full
        if $.count == len($.items) {
            $.grow();
        }
        $.items = list_remove($.items, $.tail);
        $.items = list_insert($.items, $.tail, item);
        $.tail = ($.tail + 1) % len($.items);
    }

    public dequeue(): mixed {
        if $.count == 0 { return null; }
        const item = $.items[$.head];
        $.items = list_remove($.items, $.head);
        $.items = list_insert($.items, $.head, null);
        $.head = ($.head + 1) % len($.items);
        $.count = $.count - 1;
        return item;
    }

    public peek(): mixed {
        if $.count == 0 { return null; }
        return $.items[$.head];
    }

    public size(): int { return $.count; }
    public isEmpty(): bool { return $.count == 0; }

    private grow(): void {
        const oldLen = len($.items);
        const newLen = oldLen * 2;
        let i = 0;
        while i < oldLen {
            $.items = list_push($.items, null);
            i = i + 1;
        }
        // Reorder: move items starting at head to their correct positions
        if $.head != 0 {
            let j = 0;
            while j < $.count {
                const src = ($.head + j) % oldLen;
                $.items = list_remove($.items, oldLen + j);
                $.items = list_insert($.items, oldLen + j, $.items[src]);
                j = j + 1;
            }
            $.head = oldLen;
            $.tail = ($.head + $.count) % newLen;
        }
    }
}

class Stack {
    private items: list<mixed>;
    private top: int;

    constructor() {
        $.items = [];
        $.top = -1;
    }

    public push(item: mixed): void {
        $.items = list_push($.items, item);
        $.top = $.top + 1;
    }

    public pop(): mixed {
        if $.top < 0 { return null; }
        const item = $.items[$.top];
        $.items = list_remove($.items, $.top);
        $.top = $.top - 1;
        return item;
    }

    public peek(): mixed {
        if $.top < 0 { return null; }
        return $.items[$.top];
    }

    public size(): int { return $.top + 1; }
    public isEmpty(): bool { return $.top < 0; }
}

class HashSet {
    // Open-addressing hash set with linear probing.
    // Uses sentinel values: null = empty, false = deleted (tombstone).
    private slots: list<mixed>;
    private count: int;
    private deletedCount: int;

    constructor(capacity: int) {
        const cap = capacity > 0 ? capacity : 16;
        $.slots = [];
        $.count = 0;
        $.deletedCount = 0;
        let i = 0;
        while i < cap {
            $.slots = list_push($.slots, null);
            i = i + 1;
        }
    }

    public add(value: mixed): void {
        if $.count + $.deletedCount >= len($.slots) / 2 {
            $.rehash(len($.slots) * 2);
        }
        let idx = $.probe(value);
        if $.slots[idx] == null || $.slots[idx] == false {
            $.slots = list_remove($.slots, idx);
            $.slots = list_insert($.slots, idx, value);
            $.count = $.count + 1;
        }
    }

    public has(value: mixed): bool {
        let idx = $.probe(value);
        return $.slots[idx] != null && $.slots[idx] != false;
    }

    public remove(value: mixed): void {
        let idx = $.probe(value);
        if $.slots[idx] != null && $.slots[idx] != false {
            $.slots = list_remove($.slots, idx);
            $.slots = list_insert($.slots, idx, false); // tombstone
            $.count = $.count - 1;
            $.deletedCount = $.deletedCount + 1;
        }
    }

    public size(): int { return $.count; }
    public isEmpty(): bool { return $.count == 0; }

    private probe(value: mixed): int {
        const h = int(hash(value));
        const m = len($.slots);
        let idx = h % m;
        if idx < 0 { idx = idx + m; }
        // Linear probe until we find the value, null, or a tombstone
        while $.slots[idx] != null && $.slots[idx] != false {
            if $.valuesEqual($.slots[idx], value) { break; }
            idx = (idx + 1) % m;
        }
        return idx;
    }

    private rehash(newCap: int): void {
        const oldSlots = $.slots;
        const oldCount = len(oldSlots);
        $.slots = [];
        $.count = 0;
        $.deletedCount = 0;
        let i = 0;
        while i < newCap {
            $.slots = list_push($.slots, null);
            i = i + 1;
        }
        let j = 0;
        while j < oldCount {
            if oldSlots[j] != null && oldSlots[j] != false {
                $.add(oldSlots[j]);
            }
            j = j + 1;
        }
    }

    private valuesEqual(a: mixed, b: mixed): bool {
        return toString(a) == toString(b);
    }
}
