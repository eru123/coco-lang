// std/log — Leveled, categorized logging with configurable output.

class Logger {
    private level: int;     // 0=DEBUG, 1=INFO, 2=WARN, 3=ERROR
    private name: string;

    constructor(name: string, level: string) {
        $.name = name;
        $.level = $.levelFromString(level);
    }

    public debug(msg: string): void {
        if $.level <= 0 { print("[" + $.name + "] [DEBUG] " + msg); }
    }
    public info(msg: string): void {
        if $.level <= 1 { print("[" + $.name + "] [INFO] " + msg); }
    }
    public warn(msg: string): void {
        if $.level <= 2 { print("[" + $.name + "] [WARN] " + msg); }
    }
    public error(msg: string): void {
        if $.level <= 3 { print("[" + $.name + "] [ERROR] " + msg); }
    }

    public setLevel(level: string): void {
        $.level = $.levelFromString(level);
    }

    private levelFromString(level: string): int {
        if level == "DEBUG" { return 0; }
        if level == "INFO" { return 1; }
        if level == "WARN" { return 2; }
        if level == "ERROR" { return 3; }
        return 1; // default INFO
    }
}

// Default logger instance
const defaultLogger = new Logger("app", "INFO");

export fn debug(msg: string): void { defaultLogger.debug(msg); }
export fn info(msg: string): void { defaultLogger.info(msg); }
export fn warn(msg: string): void { defaultLogger.warn(msg); }
export fn error(msg: string): void { defaultLogger.error(msg); }
export fn createLogger(name: string, level: string): Logger { return new Logger(name, level); }
