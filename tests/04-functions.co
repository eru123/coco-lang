// Functions
// Demonstrates: declaration, parameters, return values, recursion, closures

fn add(a, b) {
    return a + b;
}

fn multiply(a, b) {
    return a * b;
}

fn factorial(n) {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn fibonacci(n) {
    if n <= 1 {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn max(a, b) {
    if a > b {
        return a;
    }
    return b;
}

fn abs(x) {
    if x < 0 {
        return -x;
    }
    return x;
}

fn isEven(n) {
    return n % 2 == 0;
}

fn greet(name) {
    return "Hello, " + name + "!";
}

fn main() {
    // Basic function calls
    print(add(2, 3));
    print(multiply(4, 5));
    print(max(10, 20));
    print(abs(-7));
    print(isEven(4));
    print(isEven(7));
    print(greet("Coco"));

    // Recursion
    print(factorial(5));
    print(factorial(10));
    print(fibonacci(10));
    print(fibonacci(15));

    // Nested calls
    print(add(multiply(2, 3), multiply(4, 5)));
    print(max(factorial(4), fibonacci(8)));

    return 0;
}
