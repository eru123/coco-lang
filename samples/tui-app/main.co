// samples/tui-app/main.co — Terminal Monitoring Dashboard
// Demonstrates: BigInt, formatted output, Result type, map literals, ANSI output

fn main(): int {
    print("=================================================");
    print("       COCO MONITORING DASHBOARD (Simulated)       ");
    print("=================================================");

    // ---- Metric panels ----
    print("");
    print("[Metrics]");
    print("  CPU Usage:       45%");
    print("  Memory Used:     62,914,560,000 bytes (~58 GB)");
    print("  Total Requests:  15,832,947");
    print("  Error Count:     127");

    // ---- Progress bar ----
    print("");
    print("[Progress]");
    print("  Data Processing:  [========================>  ] 72%");
    print("  Processing 15,832,947 records...");

    // ---- Log panel ----
    print("");
    print("[Logs (5 entries)]");
    print("  [INFO] Dashboard initialized");
    print("  [INFO] Connected to 7 nodes");
    print("  [WARN] web-03 CPU at 89%");
    print("  [OK]   db-01 replication lag: 0ms");
    print("  [INFO] Cache hit ratio: 87.3%");

    // ---- Server table ----
    print("");
    print("[Server List (6 hosts)]");
    print("  Host     IP            Status   CPU      Storage");
    print("  web-01   192.168.1.10  healthy  45%      1.2TB");
    print("  web-02   192.168.1.11  healthy  52%      0.9TB");
    print("  web-03   192.168.1.12  warning  89%      1.5TB");
    print("  db-01    192.168.2.10  healthy  31%      4.2TB");
    print("  db-02    192.168.2.11  healthy  28%      3.8TB");
    print("  cache-1  192.168.3.10  healthy  67%      0.5TB");

    // ---- BigInt showcase ----
    print("");
    print("-------- BigInt Showcase --------");
    const huge = 999999999999999999;
    print("  10^18:      999,999,999,999,999,999");
    print("  10^18 + 1 = " + toString(huge + 1));
    print("  10^18 * 2 = " + toString(huge * 2));
    print("  2^100     = " + toString(2 ** 100));
    print("  50!       = " + toString(factorial(50)));
    print("  50! digits: " + toString(len(toString(factorial(50)))));

    // Fibonacci with BigInt — massive numbers
    const f150 = fibonacci(150);
    print("  fib(150)  = " + toString(f150));

    // Prime check on large number
    const bigPrime = 999999999989;  // large prime near 10^12
    print("  isPrime(999999999989) = " + toString(isPrime(bigPrime)));

    // ---- Error handling ----
    print("");
    print("-------- Error Handling --------");
    fn safeDiv(a: int, b: int): Result<int, string> {
        if b == 0 { return Err("division by zero"); }
        return Ok(a / b);
    }
    const good = safeDiv(100, 4);
    const bad = safeDiv(10, 0);
    if isOk(good) { print("  100/4 = " + toString(unwrap(good))); }
    print("  isErr(bad): " + toString(isErr(bad)));

    // Nested Result handling
    fn validateAndDouble(n: int): Result<int, string> {
        if n < 0 { return Err("negative not allowed"); }
        if n > 1000000 { return Err("too large"); }
        return Ok(n * 2);
    }
    const validResult = validateAndDouble(42);
    if isOk(validResult) { print("  42 * 2 = " + toString(unwrap(validResult))); }

    const tooBig = validateAndDouble(9999999);
    print("  too big isErr: " + toString(isErr(tooBig)));

    // ---- Math builtins ----
    print("");
    print("-------- Math Builtins --------");
    print("  abs(-99)       = " + toString(abs(-99)));
    print("  min(3,7,2,9,5) = " + toString(min(3, 7, 2, 9, 5)));
    print("  max(3,7,2,9,5) = " + toString(max(3, 7, 2, 9, 5)));
    print("  floor(3.7)     = " + toString(floor(3.7)));
    print("  ceil(3.2)      = " + toString(ceil(3.2)));
    print("  round(3.6)     = " + toString(round(3.6)));
    print("  sqrt(256)      = " + toString(sqrt(256)));
    print("  pow(2, 20)     = " + toString(pow(2, 20)));
    print("  typeOf(42)     = " + typeOf(42));
    print("  typeOf(Ok(1))  = " + typeOf(Ok(1)));

    print("");
    print("=================================================");
    print("       Dashboard rendering complete               ");
    print("=================================================");
    return 0;
}

fn factorial(n: int): int {
    if n <= 1 { return 1; }
    let result = 1;
    let i = 2;
    while i <= n { result = result * i; i = i + 1; }
    return result;
}

fn fibonacci(n: int): int {
    if n <= 0 { return 0; }
    if n == 1 { return 1; }
    let a = 0;
    let b = 1;
    let i = 1;
    while i < n {
        const c = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b;
}

fn isPrime(n: int): bool {
    if n < 2 { return false; }
    if n == 2 { return true; }
    if n % 2 == 0 { return false; }
    let i = 3;
    while i * i <= n {
        if n % i == 0 { return false; }
        i = i + 2;
    }
    return true;
}
