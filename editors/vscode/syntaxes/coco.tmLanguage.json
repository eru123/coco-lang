{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Coco",
  "scopeName": "source.coco",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#template-strings" },
    { "include": "#char-literals" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#magic-methods" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.coco",
          "match": "//.*$"
        },
        {
          "name": "comment.block.coco",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.coco",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.coco",
              "match": "\\\\(?:[\\\\\"nrt0$]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        },
        {
          "name": "string.quoted.single.coco",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.coco",
              "match": "\\\\(?:[\\\\'nrt0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        }
      ]
    },
    "template-strings": {
      "patterns": [
        {
          "name": "string.template.coco",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.coco",
              "match": "\\\\(?:[\\\\`nrt0$]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            },
            {
              "name": "meta.template.expression.coco",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.coco" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.coco" }
              },
              "patterns": [
                { "include": "source.coco" }
              ]
            }
          ]
        }
      ]
    },
    "char-literals": {
      "patterns": [
        {
          "name": "string.quoted.single.char.coco",
          "match": "'(?:[^'\\\\]|\\\\(?:[\\\\'nrt0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\}))'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.coco",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.coco",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.coco",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.coco",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.coco",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.coco",
          "match": "\\b(if|else|for|while|do|loop|break|continue|return|match|select|case|try|catch|finally|throw|await|async|parallel|run|coro|lazy|import|export|from|in|of)\\b"
        },
        {
          "name": "keyword.declaration.coco",
          "match": "\\b(const|let|fn|class|interface|trait|enum|type|constructor|extends|implements|use|static|new)\\b"
        },
        {
          "name": "keyword.modifier.coco",
          "match": "\\b(public|private|protected|readonly)\\b"
        },
        {
          "name": "keyword.operator.coco",
          "match": "\\b(typeof|is|as)\\b"
        },
        {
          "name": "keyword.other.coco",
          "match": "\\b(unsafe|synchronized|this|super)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.coco",
          "match": "\\b(var|void|never)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.coco",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.coco",
          "match": "\\b(null)\\b"
        },
        {
          "name": "constant.language.result.coco",
          "match": "\\b(Ok|Err)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.coco",
          "match": "\\b(int|uint|float|bool|string|char|byte|mixed|void|never|null)\\b"
        },
        {
          "name": "support.type.builtin.coco",
          "match": "\\b(Result|list|map|tuple|atomic|chan)\\b"
        },
        {
          "name": "entity.name.type.class.coco",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.coco",
          "match": "\\|>|<\\||->|<-"
        },
        {
          "name": "keyword.operator.comparison.coco",
          "match": "<=>|[!=]=|[<>]=?"
        },
        {
          "name": "keyword.operator.logical.coco",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.coco",
          "match": "\\*\\*=|<<=|>>=|[+\\-*/%&|^]=|="
        },
        {
          "name": "keyword.operator.arithmetic.coco",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.coco",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.nullsafe.coco",
          "match": "\\?\\.|\\.\\?|\\?\\?|\\?:|\\?"
        },
        {
          "name": "keyword.operator.spread.coco",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.coco",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.coco",
          "match": "=>"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.coco",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.coco" }
          }
        },
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.coco" },
            "2": { "name": "entity.name.function.coco" }
          }
        }
      ]
    },
    "magic-methods": {
      "patterns": [
        {
          "name": "support.function.magic.coco",
          "match": "\\b(__toString|__get|__set|__call|__invoke|__compare|__clone|__destruct)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.coco",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
