{
  "name": "coco-lang",
  "displayName": "Coco Language",
  "description": "Syntax highlighting, snippets, and language support for the Coco programming language",
  "version": "0.1.0",
  "publisher": "coco-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "coco",
        "aliases": [
          "Coco",
          "coco"
        ],
        "extensions": [
          ".co"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "coco",
        "scopeName": "source.coco",
        "path": "./syntaxes/coco.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "coco",
        "path": "./snippets/coco.json"
      }
    ]
  }
}
